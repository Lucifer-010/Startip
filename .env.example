# ==============================================================================
# StarTip Environment Variables Configuration (Dokploy / Production Template)
# ==============================================================================

# --- Django Security Settings ---
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-this-to-a-secure-random-64-character-secret-in-production
DJANGO_ALLOWED_HOSTS=*
DOMAIN=your-startip-domain.com
PORT=8000

# --- Database Settings (PostgreSQL) ---
# Set DATABASE_URL or individual POSTGRES credentials
DATABASE_URL=postgresql://startip:startippassword@db:5432/startip
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=startip
POSTGRES_USER=startip
POSTGRES_PASSWORD=startippassword

# --- Stellar Network Settings ---
STELLAR_NETWORK=TESTNET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Stellar Testnet USDC Issuer (Circle Official Testnet Asset)
STELLAR_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# --- OpenAI Services Settings ---
# Required for AI message moderation and automated thank-you note generation
# If not provided, fallback heuristic analyzer & template engine are used automatically.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Initial Data Seeding ---
# Automatically seeds demo creator @alex_dev and sample tips on startup
SEED_DEMO_DATA=true
